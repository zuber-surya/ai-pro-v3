# Copy to .env.local — never commit secrets.
# Vercel: Project Settings → Environment Variables (Preview = staging, Production = prod).
# Only NEXT_PUBLIC_* values are exposed to the browser; do not put JWT/Gemini/DB secrets here.

# Local
NEXT_PUBLIC_API_BASE_URL=http://localhost:4001/api/v1

# Staging example (Preview)
# NEXT_PUBLIC_API_BASE_URL=https://api-staging.example.com/api/v1

# Production example
# NEXT_PUBLIC_API_BASE_URL=https://api.example.com/api/v1
