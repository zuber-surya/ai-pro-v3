generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  customer
  agent
  admin
  super_admin
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(320)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         Role      @default(customer)
  fullName     String?   @map("full_name") @db.VarChar(200)
  phone        String?   @db.VarChar(40)
  avatarUrl    String?   @map("avatar_url")
  isActive     Boolean   @default(true) @map("is_active")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  agent         Agent?
  leads         Lead[]
  favorites       Favorite[]
  savedSearches   SavedSearch[]
  customerProfile CustomerProfile?
  notifications   Notification[]
  aiConfigsCreated AiConfig[] @relation("AiConfigCreatedBy")
  aiConfigsUpdated AiConfig[] @relation("AiConfigUpdatedBy")
  bulkUploadSessions BulkUploadSession[]
  leadNotes         LeadNote[]
  visitsRequested   Visit[] @relation("VisitCustomer")
  visitsCreated     Visit[] @relation("VisitCreatedBy")

  @@index([role], map: "ix_users_role")
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "ix_refresh_tokens_user_id")
  @@index([expiresAt], map: "ix_refresh_tokens_expires_at")
  @@map("refresh_tokens")
}

model Agent {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String?  @unique @map("user_id") @db.Uuid
  name             String   @db.VarChar(200)
  email            String   @db.VarChar(320)
  phone            String?  @db.VarChar(40)
  profileImageUrl  String?  @map("profile_image_url")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  properties Property[]
  leads      Lead[]

  @@index([email], map: "ix_agents_email")
  @@index([isActive], map: "ix_agents_is_active")
  @@map("agents")
}

enum PropertyStatus {
  draft
  published
  archived
  sold
  rented
}

model Property {
  id            String         @id @default(uuid()) @db.Uuid
  title         String         @db.VarChar(300)
  description   String?
  status        PropertyStatus @default(draft)
  price         Decimal        @db.Decimal(14, 2)
  currency      String         @default("INR") @db.Char(3)
  propertyType  String         @map("property_type") @db.VarChar(80)
  bedrooms      Int            @default(0) @map("beds")
  bathrooms     Decimal        @default(0) @map("baths") @db.Decimal(4, 1)
  areaSqFt      Decimal        @default(0) @map("sqft") @db.Decimal(12, 2)
  addressLine   String         @map("address_line") @db.VarChar(500)
  city          String?        @db.VarChar(120)
  region        String?        @db.VarChar(120)
  postalCode    String?        @map("postal_code") @db.VarChar(32)
  country       String?        @db.VarChar(120)
  yearBuilt     Int?           @map("year_built")
  featured      Boolean        @default(false)
  agentId       String?        @map("agent_id") @db.Uuid
  lat           Float?
  lng           Float?
  viewsCount    Int            @default(0) @map("views_count")
  savesCount    Int            @default(0) @map("saves_count")
  publishedAt   DateTime?      @map("published_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  agent Agent? @relation(fields: [agentId], references: [id], onDelete: SetNull)
  amenities PropertyAmenity[]
  images    PropertyImage[]
  landmarks NearbyLandmark[]
  leads     Lead[]
  favorites Favorite[]
  viewEvents PropertyViewEvent[]
  visits    Visit[]

  @@index([status], map: "ix_properties_status")
  @@index([price], map: "ix_properties_price")
  @@index([city], map: "ix_properties_city")
  @@index([propertyType], map: "ix_properties_type")
  @@index([agentId], map: "ix_properties_agent_id")
  @@index([publishedAt], map: "ix_properties_published_at")
  @@map("properties")
}

model NearbyLandmark {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @map("property_id") @db.Uuid
  name       String   @db.VarChar(200)
  category   String?  @db.VarChar(80)
  distanceM  Int?     @map("distance_m")
  lat        Float?
  lng        Float?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId], map: "ix_nearby_landmarks_property_id")
  @@map("nearby_landmarks")
}

model PropertyAmenity {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @map("property_id") @db.Uuid
  name       String   @db.VarChar(120)
  isCustom   Boolean  @default(false) @map("is_custom")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, name], map: "uq_property_amenities_property_name")
  @@index([propertyId], map: "ix_property_amenities_property_id")
  @@map("property_amenities")
}

enum PropertyImageKind {
  photo
  floorplan
}

model PropertyImage {
  id         String            @id @default(uuid()) @db.Uuid
  propertyId String            @map("property_id") @db.Uuid
  url        String
  kind       PropertyImageKind @default(photo)
  sortOrder  Int               @default(0) @map("sort_order")
  caption    String?           @db.VarChar(300)
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, sortOrder], map: "ix_property_images_property_id_sort")
  @@map("property_images")
}

model Favorite {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  propertyId String   @map("property_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId], map: "uq_favorites_user_property")
  @@index([propertyId], map: "ix_favorites_property_id")
  @@index([userId], map: "ix_favorites_user_id")
  @@map("favorites")
}

model SavedSearch {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  name        String   @db.VarChar(200)
  queryText   String?  @map("query_text")
  filtersJson Json?    @map("filters_json")
  notifyVia   String?  @map("notify_via") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "ix_saved_searches_user_id")
  @@map("saved_searches")
}

model CustomerProfile {
  id                       String   @id @default(uuid()) @db.Uuid
  userId                   String   @unique @map("user_id") @db.Uuid
  budgetMin                Decimal? @map("budget_min") @db.Decimal(14, 2)
  budgetMax                Decimal? @map("budget_max") @db.Decimal(14, 2)
  propertyTypesJson        Json?    @map("property_types_json")
  bedsMin                  Int?     @map("beds_min")
  locationPreferencesJson  Json?    @map("location_preferences_json")
  completionPct            Int      @default(0) @map("completion_pct")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_profiles")
}

enum LeadStage {
  new
  contacted
  qualified
  visit_scheduled
  negotiation
  won
  lost
}

model Lead {
  id                   String    @id @default(uuid()) @db.Uuid
  name                 String    @db.VarChar(200)
  email                String    @db.VarChar(320)
  phone                String?   @db.VarChar(40)
  preferredContactTime String?   @map("preferred_contact_time") @db.VarChar(120)
  message              String?
  source               String    @db.VarChar(80)
  stage                LeadStage @default(new)
  score                Decimal?  @db.Decimal(5, 2)
  propertyId           String?   @map("property_id") @db.Uuid
  assigneeAgentId      String?   @map("assignee_agent_id") @db.Uuid
  customerUserId       String?   @map("customer_user_id") @db.Uuid
  idempotencyKey       String?   @unique @map("idempotency_key") @db.VarChar(100)
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  assignee Agent?    @relation(fields: [assigneeAgentId], references: [id], onDelete: SetNull)
  customer User?     @relation(fields: [customerUserId], references: [id], onDelete: SetNull)
  notes    LeadNote[]
  visits   Visit[]

  @@index([stage], map: "ix_leads_stage")
  @@index([email], map: "ix_leads_email")
  @@index([assigneeAgentId], map: "ix_leads_assignee")
  @@index([propertyId], map: "ix_leads_property_id")
  @@index([createdAt], map: "ix_leads_created_at")
  @@map("leads")
}

model LeadNote {
  id        String   @id @default(uuid()) @db.Uuid
  leadId    String   @map("lead_id") @db.Uuid
  authorId  String?  @map("author_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lead   Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt], map: "ix_lead_notes_lead_id_created_at")
  @@map("lead_notes")
}

enum VisitStatus {
  requested
  confirmed
  cancelled
  completed
}

model Visit {
  id              String      @id @default(uuid()) @db.Uuid
  propertyId      String      @map("property_id") @db.Uuid
  scheduledAt     DateTime    @map("scheduled_at")
  status          VisitStatus @default(requested)
  notes           String?
  customerUserId  String?     @map("customer_user_id") @db.Uuid
  createdByUserId String?     @map("created_by_user_id") @db.Uuid
  leadId          String?     @map("lead_id") @db.Uuid
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  property  Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  customer  User?    @relation("VisitCustomer", fields: [customerUserId], references: [id], onDelete: SetNull)
  createdBy User?    @relation("VisitCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([propertyId], map: "ix_visits_property_id")
  @@index([scheduledAt], map: "ix_visits_scheduled_at")
  @@index([status], map: "ix_visits_status")
  @@index([customerUserId], map: "ix_visits_customer_user_id")
  @@index([leadId], map: "ix_visits_lead_id")
  @@map("visits")
}

model Notification {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  type        String    @db.VarChar(80)
  title       String    @db.VarChar(300)
  body        String?
  payloadJson Json?     @map("payload_json")
  readAt      DateTime? @map("read_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt], map: "ix_notifications_user_id_created_at")
  @@map("notifications")
}

enum NotificationChannel {
  email
  in_app
}

model NotificationRule {
  id          String              @id @default(uuid()) @db.Uuid
  eventType   String              @map("event_type") @db.VarChar(80)
  channel     NotificationChannel
  isEnabled   Boolean             @default(true) @map("is_enabled")
  templateKey String?             @map("template_key") @db.VarChar(120)
  configJson  Json?               @map("config_json")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  createdBy   String?             @map("created_by") @db.Uuid
  updatedBy   String?             @map("updated_by") @db.Uuid

  @@unique([eventType, channel], map: "uq_notification_rules_event_channel")
  @@map("notification_rules")
}

model CmsPage {
  id          String    @id @default(uuid()) @db.Uuid
  slug        String    @unique @db.VarChar(160)
  title       String    @db.VarChar(300)
  bodyJson    Json      @map("body_json")
  isPublished Boolean   @default(false) @map("is_published")
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdBy   String?   @map("created_by") @db.Uuid
  updatedBy   String?   @map("updated_by") @db.Uuid

  @@index([isPublished], map: "ix_cms_pages_published")
  @@map("cms_pages")
}

model AiConfig {
  id             String   @id @default(uuid()) @db.Uuid
  key            String   @unique @db.VarChar(80)
  greeting       String
  faqsJson       Json     @default("[]") @map("faqs_json")
  escalationJson Json     @default("{}") @map("escalation_json")
  tone           String?  @db.VarChar(40)
  promptsJson    Json     @default("{}") @map("prompts_json")
  modelLabel     String   @default("gemini") @map("model_label") @db.VarChar(80)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdBy      String?  @map("created_by") @db.Uuid
  updatedBy      String?  @map("updated_by") @db.Uuid

  createdByUser User? @relation("AiConfigCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser User? @relation("AiConfigUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@map("ai_configs")
}

model PropertyViewEvent {
  id           String   @id @default(uuid()) @db.Uuid
  propertyId   String   @map("property_id") @db.Uuid
  viewerUserId String?  @map("viewer_user_id") @db.Uuid
  sessionId    String?  @map("session_id") @db.VarChar(100)
  viewedAt     DateTime @default(now()) @map("viewed_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, viewedAt], map: "ix_property_view_events_property_viewed")
  @@index([viewedAt], map: "ix_property_view_events_viewed_at")
  @@map("property_view_events")
}

model MetricsDailySnapshot {
  id                    String   @id @default(uuid()) @db.Uuid
  snapshotDate          DateTime @map("snapshot_date") @db.Date
  activeListings        Int      @default(0) @map("active_listings")
  activeLeads           Int      @default(0) @map("active_leads")
  conversionRate        Decimal  @default(0) @map("conversion_rate") @db.Decimal(7, 4)
  sessionsCount         Int      @default(0) @map("sessions_count")
  leadSourcesJson       Json?    @map("lead_sources_json")
  stageDistributionJson Json?    @map("stage_distribution_json")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@unique([snapshotDate], map: "uq_metrics_daily_snapshots_date")
  @@map("metrics_daily_snapshots")
}

model BulkUploadSession {
  id              String   @id @default(uuid()) @db.Uuid
  uploadedBy      String   @map("uploaded_by") @db.Uuid
  fileName        String   @default("records.json") @map("file_name") @db.VarChar(300)
  totalRows       Int      @default(0) @map("total_rows")
  validRows       Int      @default(0) @map("valid_rows")
  errorRows       Int      @default(0) @map("error_rows")
  warningRows     Int      @default(0) @map("warning_rows")
  status          String   @default("validated") @db.VarChar(40)
  idempotencyKey  String?  @unique @map("idempotency_key") @db.VarChar(100)
  validRecordsJson Json    @default("[]") @map("valid_records_json")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  uploader User                 @relation(fields: [uploadedBy], references: [id], onDelete: Restrict)
  errors   BulkUploadRowError[]

  @@index([uploadedBy, createdAt], map: "ix_bulk_upload_sessions_uploader_created")
  @@map("bulk_upload_sessions")
}

model BulkUploadRowError {
  id            String   @id @default(uuid()) @db.Uuid
  sessionId     String   @map("session_id") @db.Uuid
  rowNumber     Int      @map("row_number")
  fieldName     String?  @map("field_name") @db.VarChar(120)
  message       String
  originalValue String?  @map("original_value")
  suggestion    String?
  severity      String   @default("error") @db.VarChar(20)
  createdAt     DateTime @default(now()) @map("created_at")

  session BulkUploadSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, rowNumber], map: "ix_bulk_upload_row_errors_session_row")
  @@map("bulk_upload_row_errors")
}
