generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  customer
  agent
  admin
  super_admin
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(320)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         Role      @default(customer)
  fullName     String?   @map("full_name") @db.VarChar(200)
  phone        String?   @db.VarChar(40)
  avatarUrl    String?   @map("avatar_url")
  isActive     Boolean   @default(true) @map("is_active")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  agent         Agent?

  @@index([role], map: "ix_users_role")
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "ix_refresh_tokens_user_id")
  @@index([expiresAt], map: "ix_refresh_tokens_expires_at")
  @@map("refresh_tokens")
}

model Agent {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String?  @unique @map("user_id") @db.Uuid
  name             String   @db.VarChar(200)
  email            String   @db.VarChar(320)
  phone            String?  @db.VarChar(40)
  profileImageUrl  String?  @map("profile_image_url")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  properties Property[]

  @@index([email], map: "ix_agents_email")
  @@index([isActive], map: "ix_agents_is_active")
  @@map("agents")
}

enum PropertyStatus {
  draft
  published
  archived
  sold
  rented
}

model Property {
  id            String         @id @default(uuid()) @db.Uuid
  title         String         @db.VarChar(300)
  description   String?
  status        PropertyStatus @default(draft)
  price         Decimal        @db.Decimal(14, 2)
  currency      String         @default("INR") @db.Char(3)
  propertyType  String         @map("property_type") @db.VarChar(80)
  bedrooms      Int            @default(0) @map("beds")
  bathrooms     Decimal        @default(0) @map("baths") @db.Decimal(4, 1)
  areaSqFt      Decimal        @default(0) @map("sqft") @db.Decimal(12, 2)
  addressLine   String         @map("address_line") @db.VarChar(500)
  city          String?        @db.VarChar(120)
  region        String?        @db.VarChar(120)
  postalCode    String?        @map("postal_code") @db.VarChar(32)
  country       String?        @db.VarChar(120)
  yearBuilt     Int?           @map("year_built")
  featured      Boolean        @default(false)
  agentId       String?        @map("agent_id") @db.Uuid
  lat           Float?
  lng           Float?
  viewsCount    Int            @default(0) @map("views_count")
  savesCount    Int            @default(0) @map("saves_count")
  publishedAt   DateTime?      @map("published_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  agent Agent? @relation(fields: [agentId], references: [id], onDelete: SetNull)
  amenities PropertyAmenity[]

  @@index([status], map: "ix_properties_status")
  @@index([price], map: "ix_properties_price")
  @@index([city], map: "ix_properties_city")
  @@index([propertyType], map: "ix_properties_type")
  @@index([agentId], map: "ix_properties_agent_id")
  @@index([publishedAt], map: "ix_properties_published_at")
  @@map("properties")
}

model PropertyAmenity {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @map("property_id") @db.Uuid
  name       String   @db.VarChar(120)
  isCustom   Boolean  @default(false) @map("is_custom")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, name], map: "uq_property_amenities_property_name")
  @@index([propertyId], map: "ix_property_amenities_property_id")
  @@map("property_amenities")
}
