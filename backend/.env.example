# Copy to .env for local development. Never commit secrets.

PORT=4001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/propvista?schema=public
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AI_SEARCH_TIMEOUT_MS=8000
AI_SEARCH_RATE_LIMIT_MAX=30
AI_SEARCH_RATE_LIMIT_WINDOW_MS=60000
CORS_ORIGIN=http://localhost:3001
STORAGE_ROOT=./storage
EMAIL_FROM=noreply@example.com
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
NODE_ENV=development
APP_VERSION=0.1.0
